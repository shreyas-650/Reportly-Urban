# ==============================================================================
# ReportlyUrban — Backend Environment Configuration Template
# ==============================================================================
# DO NOT commit real API keys or service role secrets to version control.
# Copy this file to backend/.env and replace placeholders.
# ==============================================================================

# Google Gemini Vision API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Supabase Project Configuration (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Secret (for persistent rate-limiting table access)
# Found in: Supabase Dashboard -> Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Quota & Safety Limits
GLOBAL_DAILY_AI_CAP=500
USER_DAILY_AI_LIMIT=10
MAX_IMAGE_SIZE_BYTES=5242880
MAX_IMAGE_PIXELS=10000000

# Allowed CORS Origins (comma separated list, no wildcards)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 6 Public Accountability API Configuration
ENVIRONMENT=development
PUBLIC_RPC_TIMEOUT_SECONDS=10.0
PUBLIC_RATE_LIMIT_PER_MINUTE=60
TRUSTED_PROXY_HOPS=0
PUBLIC_CACHE_MAX_ENTRIES=512

# Phase 7.2 Internal SLA Sweep Configuration
# Generate a random secret of at least 32 characters (never commit real secrets)
SLA_SWEEP_SECRET=replace_with_a_random_secret_of_at_least_32_characters
SLA_SWEEP_RATE_LIMIT_PER_MINUTE=6
SLA_SWEEP_DEFAULT_BATCH=100
SLA_SWEEP_TIMEOUT_SECONDS=30.0

# Phase 8.2 Advisory AI Before-and-After Comparison (defaults to false / fail-closed)
AI_RESOLUTION_CHECK_ENABLED=false
AI_RESOLUTION_DAILY_CAP=200
AI_RESOLUTION_RERUN_PER_USER_PER_MINUTE=6
AI_RESOLUTION_RERUN_GLOBAL_PER_MINUTE=20
AI_RESOLUTION_PENDING_TIMEOUT_MINUTES=5
