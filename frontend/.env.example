# ==============================================================================
# Reportly Urban — Frontend Environment Configuration Template
# ==============================================================================
# Replace placeholder values with your Supabase project credentials.
# Found in: Supabase Dashboard -> Project Settings -> API
# Note: NEVER expose your SUPABASE_SERVICE_ROLE_KEY in frontend code!
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Mapbox Public Access Token (Phase 4.4 Geospatial Intelligence)
# Create a free public token at https://account.mapbox.com/
# Format: pk.eyJ1... (NEVER use a secret token starting with sk. in the frontend)
VITE_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token-here

# ReportlyUrban AI Problem Detection Service (Phase 5)
VITE_AI_SERVICE_URL=http://localhost:8000
